# ═══════════════════════════════════════════════════════════════
# .gitignore — revoa
# (herda regras globais: nunca commitar secrets, binários > 50MB)
# ═══════════════════════════════════════════════════════════════

# ── Secrets / ambiente (NUNCA commitar) ─────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.env.cloudflare
cloudflared/cred.json
**/cred.json

# ── .NET ────────────────────────────────────────────────────────
**/bin/
**/obj/
**/artifacts/
*.user
*.suo
*.userprefs
*.cache
*.log
*.pidb
*.swp
TestResults/
*.coverage
*.coveragexml

# ── Node / Frontend (React + Vite) ──────────────────────────────
**/node_modules/
**/dist/
**/dist-ssr/
**/.vite/
*.local
.eslintcache
# Playwright
playwright-report/
test-results/
e2e/.auth/

# ── Foundry / Solidity ──────────────────────────────────────────
# forge dependencies e artefatos (reinstalaveis via 'forge install')
contracts/lib/
contracts/cache/
contracts/out/
contracts/broadcast/
contracts/.chainId
contracts/lib/
cache/
out/
broadcast/
*.tsbuildinfo

# ── Binários grandes (regra global) ─────────────────────────────
*.msi
*.exe
*.dll
*.zip
*.tar.gz
*.7z
*.iso

# ── Logs Serilog (rotativos) ────────────────────────────────────
logs/

# ── Dados locais / volumes ──────────────────────────────────────
data/
mongo-data/
minio-data/
chain-data/

# ── IDE / SO ────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ── Ollama / modelos ────────────────────────────────────────────
ollama-models/
*.gguf

# Snapshots efêmeros do plugin Playwright MCP
.playwright-mcp/
